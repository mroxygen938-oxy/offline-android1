{
  "name": "oxygen-vault-offline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "windows/main.cjs",
  "description": "Offline anime + manga tracker — Android APK, Windows EXE, and Linux AppImage / .deb / .tar.gz built from the same React UI.",
  "author": {
    "name": "OxygenVault",
    "email": "support@oxygenvault.online"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --config.extraMetadata.main=windows/main.cjs",
    "electron:build:portable": "npm run build && electron-builder --win portable --config.extraMetadata.main=windows/main.cjs",
    "electron:build:linux": "npm run build && electron-builder --linux --config.extraMetadata.main=linux/main.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  },
  "build": {
    "appId": "online.oxygenvault.offline",
    "productName": "Oxygen Vault Offline",
    "copyright": "Copyright © OxygenVault",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "windows/**/*",
      "linux/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "OxygenVault-Offline-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Oxygen Vault Offline"
    },
    "portable": {
      "artifactName": "OxygenVault-Offline-${version}-portable.exe"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Offline anime + manga tracker",
      "description": "Local-first anime + manga tracker. No login, no server, no internet required.",
      "artifactName": "OxygenVault-Offline-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Oxygen Vault Offline",
          "Comment": "Offline anime + manga tracker",
          "Categories": "Utility;Office;"
        }
      }
    }
  }
}
